<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>

    <!-- Section 34 "Configurable internal server address" / "Optional Desktop shortcut". -->
    <Property Id="SERVERURL" Value="http://ntnp-pricing-server:5252" Secure="yes" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <!--
      UI/Dialog/Publish are core WiX elements (base wxs namespace, unprefixed) — NOT the ui:
      extension namespace, which only owns the stock <ui:WixUI> reference used in Package.wxs.
      Confirmed by decompiling WixToolset.Core.dll's Compiler.ParseFragmentElement/ParseUIElement:
      both dispatch on CompilerCore.WixNamespace (the core namespace) for "UI"/"Dialog"/"Publish".
      An earlier attempt used the ui: prefix for these, which produced WIX0005 "The Fragment element
      contains an unexpected child element 'Dialog'" on a real Windows WiX build — Dialog wasn't
      unrecognized, it was in the wrong namespace, so the UI extension (which only handles WixUI)
      rejected it.
    -->
    <UI>
      <Dialog Id="ServerAddressDlg" Width="370" Height="270" Title="NTNP Pricing Engine Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="240" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Server Connection</Text>
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="Enter the address of the NTNP Pricing Engine server used by everyone on this computer. You (or any user) can change it later from the application's own Server Connection Settings screen — this is only the initial default." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="ServerUrlLabel" Type="Text" X="20" Y="60" Width="200" Height="15" NoPrefix="yes" Text="Server address (Base URL):" />
        <Control Id="ServerUrlEdit" Type="Edit" X="20" Y="76" Width="330" Height="18" Property="SERVERURL" />
        <Control Id="ServerUrlHint" Type="Text" X="20" Y="97" Width="330" Height="24" Transparent="yes" NoPrefix="yes"
                 Text="Example: http://ntnp-pricing-server:5252 (ask your system administrator if unsure)." />

        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="130" Width="300" Height="18"
                 Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a desktop shortcut" />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="BackButton" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        <Control Id="NextButton" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="CancelButton" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <!--
        Splices this dialog into the stock WixUI_InstallDir sequence, right after the folder-picker
        (InstallDirDlg) and before the final confirmation screen (VerifyReadyDlg). WixUI_InstallDir
        already publishes its own InstallDirDlg-Next -> VerifyReadyDlg and VerifyReadyDlg-Back ->
        InstallDirDlg rows at a low Order; a ControlEvent's Value takes effect from whichever
        qualifying row is evaluated last for that Order sequence, so a deliberately high Order (10)
        here reliably wins over the library's own low-numbered rows without needing to know their
        exact value. Verify this wizard's Back/Next flow visually on the first real Windows build —
        see docs/deployment.md's installer build/QA checklist.
      -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ServerAddressDlg" Order="10">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ServerAddressDlg" Order="10">1</Publish>
    </UI>

  </Fragment>
</Wix>
