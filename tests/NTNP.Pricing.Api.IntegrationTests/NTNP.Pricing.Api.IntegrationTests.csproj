<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!--
      EF Core InMemory (not SQLite) — see SeededServiceProviderFixture.cs in Infrastructure.Tests
      for the rationale: InMemory natively emulates ValueGenerated.OnAddOrUpdate concurrency tokens
      (RowVersion) the way SQL Server's `rowversion` does; SQLite needs trigger SQL only real
      migrations emit. The real SQL Server migration SQL is exercised separately (Migrations folder
      + docs/deployment.md).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NTNP.Pricing.Api\NTNP.Pricing.Api.csproj" />
    <ProjectReference Include="..\..\src\NTNP.Pricing.Contracts\NTNP.Pricing.Contracts.csproj" />
    <ProjectReference Include="..\..\src\NTNP.Pricing.Infrastructure\NTNP.Pricing.Infrastructure.csproj" />
  </ItemGroup>

</Project>
