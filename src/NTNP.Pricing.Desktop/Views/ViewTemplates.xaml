<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:NTNP.Pricing.Desktop.ViewModels"
                    xmlns:views="clr-namespace:NTNP.Pricing.Desktop.Views">

    <!--
        Section 23 — view-model-first navigation: NavigationService swaps CurrentViewModel, and the
        shell's ContentControl resolves the matching View purely from these DataTemplates. Adding a
        new screen never touches the shell itself — just a view model, a view, and one entry here.
    -->

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><views:CustomersView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:EquipmentViewModel}"><views:EquipmentView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CurrenciesViewModel}"><views:CurrenciesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PanelTemplatesViewModel}"><views:PanelTemplatesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:BodyEsTemplatesViewModel}"><views:BodyEsTemplatesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PricingProfilesViewModel}"><views:PricingProfilesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProjectListViewModel}"><views:ProjectListView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:NewProjectWizardViewModel}"><views:NewProjectWizardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProjectWorkspaceViewModel}"><views:ProjectWorkspaceView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UsersViewModel}"><views:UsersView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AuditLogViewModel}"><views:AuditLogView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CompanySettingsViewModel}"><views:CompanySettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ServerConnectionSettingsViewModel}"><views:ServerConnectionSettingsView /></DataTemplate>

</ResourceDictionary>
