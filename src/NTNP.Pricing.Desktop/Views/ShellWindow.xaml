<Window x:Class="NTNP.Pricing.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NTNP.Pricing.Desktop.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="موتور قیمت‌گذاری NTNP" Height="900" Width="1500" MinHeight="650" MinWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryNavyBrush}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleNavCommand}" ToolTip="نمایش/پنهان‌سازی منو">
                    <TextBlock Text="&#9776;" Foreground="White" FontSize="16" />
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Resources/logo.png" Width="30" Height="30" />
                    <TextBlock Text="NTNP Pricing Engine" Foreground="White" FontFamily="{StaticResource PersianSemiBoldFontFamily}" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Breadcrumb / current module -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Navigation.CurrentModuleGroup}" Foreground="#9FB3CC" FontSize="12.5"
                               Visibility="{Binding Navigation.CurrentModuleGroup, Converter={StaticResource TruthyToVisibility}}" />
                    <TextBlock Text=" / " Foreground="#9FB3CC" FontSize="12.5"
                               Visibility="{Binding Navigation.CurrentModuleGroup, Converter={StaticResource TruthyToVisibility}}" />
                    <TextBlock Text="{Binding Navigation.CurrentModuleTitle}" Foreground="White" FontFamily="{StaticResource PersianMediumFontFamily}" FontSize="13.5" />
                </StackPanel>

                <!-- Server status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Session.IsServerReachable}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Foreground="#C7D3E0" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="سرور متصل است" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Session.IsServerReachable}" Value="False">
                                        <Setter Property="Text" Value="ارتباط با سرور قطع است" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Current user -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Session.CurrentUser.DisplayName}" Foreground="White" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock Text=" · " Foreground="#9FB3CC" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Session.CurrentUser.Roles[0], Converter={StaticResource StatusToPersianLabel}, FallbackValue=''}"
                               Foreground="#9FB3CC" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="5" Content="خروج" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LogoutCommand}" Padding="14,7" />
            </Grid>
        </Border>

        <!-- ===== Body: nav + content ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Nav -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="230" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                <Setter Property="Width" Value="64" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,0,14">

                        <TextBlock Text="داشبورد" Style="{StaticResource NavGroupHeaderStyle}" Visibility="{Binding IsNavCollapsed, Converter={StaticResource FalsyToVisibility}}" />
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateDashboardCommand}">
                            <TextBlock Text="داشبورد" Style="{StaticResource NavItemTextStyle}" />
                        </Button>

                        <TextBlock Text="اطلاعات پایه" Style="{StaticResource NavGroupHeaderStyle}" Visibility="{Binding IsNavCollapsed, Converter={StaticResource FalsyToVisibility}}" />
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateCustomersCommand}"><TextBlock Text="مشتریان" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateEquipmentCommand}"><TextBlock Text="بانک تجهیزات" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateCurrenciesCommand}"><TextBlock Text="نرخ ارز" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigatePanelTemplatesCommand}"><TextBlock Text="تیپ تابلوها" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateBodyEsCommand}"><TextBlock Text="BODY+ES" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigatePricingProfilesCommand}"><TextBlock Text="پروفایل قیمت‌گذاری" Style="{StaticResource NavItemTextStyle}" /></Button>

                        <TextBlock Text="پروژه‌ها" Style="{StaticResource NavGroupHeaderStyle}" Visibility="{Binding IsNavCollapsed, Converter={StaticResource FalsyToVisibility}}" />
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateProjectListCommand}"><TextBlock Text="پروژه‌های قیمت‌گذاری" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateNewProjectCommand}"><TextBlock Text="پروژه جدید" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateApprovalQueueCommand}"><TextBlock Text="بررسی و تأیید" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateProjectListCommand}"><TextBlock Text="نسخه‌ها" Style="{StaticResource NavItemTextStyle}" /></Button>

                        <TextBlock Text="گزارش‌ها" Style="{StaticResource NavGroupHeaderStyle}" Visibility="{Binding IsNavCollapsed, Converter={StaticResource FalsyToVisibility}}" />
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateProjectListCommand}"><TextBlock Text="BOM" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateProjectListCommand}"><TextBlock Text="MTO" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateProjectListCommand}"><TextBlock Text="گزارش قیمت" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateProjectListCommand}"><TextBlock Text="پیشنهاد قیمت مشتری" Style="{StaticResource NavItemTextStyle}" /></Button>

                        <TextBlock Text="مدیریت سیستم" Style="{StaticResource NavGroupHeaderStyle}" Visibility="{Binding IsNavCollapsed, Converter={StaticResource FalsyToVisibility}}" />
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateUsersCommand}"
                                Visibility="{Binding Session.CurrentUser.Roles, Converter={StaticResource RolesContains}, ConverterParameter=Admin}">
                            <TextBlock Text="کاربران" Style="{StaticResource NavItemTextStyle}" />
                        </Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateAuditLogCommand}"
                                Visibility="{Binding Session.CurrentUser.Roles, Converter={StaticResource RolesContains}, ConverterParameter=Admin}">
                            <TextBlock Text="گزارش فعالیت‌ها" Style="{StaticResource NavItemTextStyle}" />
                        </Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateCompanySettingsCommand}"><TextBlock Text="تنظیمات" Style="{StaticResource NavItemTextStyle}" /></Button>
                        <Button Style="{StaticResource NavItemStyle}" Command="{Binding NavigateServerSettingsCommand}"><TextBlock Text="اتصال به سرور" Style="{StaticResource NavItemTextStyle}" /></Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Content -->
            <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <ContentControl Content="{Binding Navigation.CurrentViewModel}" Margin="24" />
            </Border>
        </Grid>
    </Grid>
</Window>
