<Application x:Class="NTNP.Pricing.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NTNP.Pricing.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Views/ViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:TruthyToVisibilityConverter x:Key="TruthyToVisibility" />
            <conv:TruthyToVisibilityConverter x:Key="FalsyToVisibility" Invert="True" />
            <conv:InverseBooleanConverter x:Key="InverseBoolean" />
            <conv:IrrAmountConverter x:Key="IrrAmount" />
            <conv:ForeignAmountConverter x:Key="ForeignAmount" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:StatusToBadgeKindConverter x:Key="StatusToBadgeKind" />
            <conv:StatusToPersianLabelConverter x:Key="StatusToPersianLabel" />
            <conv:RolesContainsConverter x:Key="RolesContains" />
            <conv:FractionToWidthConverter x:Key="FractionToWidth" />

            <!-- Section 23: default application-wide look — RTL flow, Persian font, corporate background. -->
            <Style TargetType="Window">
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="FontFamily" Value="{StaticResource PersianFontFamily}" />
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyTextStyle}" />
            <Style TargetType="{x:Type Page}">
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="FontFamily" Value="{StaticResource PersianFontFamily}" />
            </Style>
            <Style TargetType="{x:Type UserControl}">
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="FontFamily" Value="{StaticResource PersianFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
