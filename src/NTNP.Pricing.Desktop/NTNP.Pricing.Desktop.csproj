<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>NTNP.Pricing.Desktop</RootNamespace>
    <AssemblyName>NTNP.Pricing.Desktop</AssemblyName>
    <ApplicationIcon>Assets\ntnp.ico</ApplicationIcon>
    <!-- Allows `dotnet build` to cross-compile this Windows-only WPF app on non-Windows CI/dev
         machines (used in this repository's Linux sandbox for verification builds). It has no
         effect on Windows and the shipped product still targets Windows 10/11 x64 only, per the
         product definition. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <!-- Section 7 (ASSUMPTIONS.md) — encrypts the "remember me" refresh token at rest via Windows DPAPI. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NTNP.Pricing.Contracts\NTNP.Pricing.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- This WPF SDK project's implicit-usings set is narrower than the ASP.NET Core/console one
         (no System.Net.Http, no System.IO) even with <ImplicitUsings>enable</ImplicitUsings> — both
         are used pervasively (every *ApiClient.cs takes an HttpClient; several view models read/write
         report files), so they're added project-wide here instead of per-file. -->
    <Using Include="System.Net.Http" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\Vazirmatn-Regular.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Medium.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Vazirmatn-Bold.ttf" />
    <Resource Include="Resources\logo.png" />
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
