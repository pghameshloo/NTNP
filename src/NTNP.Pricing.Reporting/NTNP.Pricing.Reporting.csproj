<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NTNP.Pricing.Reporting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-platform, MIT/Apache-2.0-licensed report generation stack (royalty-free at any
         company size, unlike revenue-gated alternatives). See docs/package-licenses.md.
         PDF is generated by rendering an HTML+CSS template through headless Chromium
         (Microsoft.Playwright) rather than MigraDoc/PdfSharp: MigraDoc has no bidirectional-text
         (BiDi) support, so it cannot correctly lay out Persian RTL text mixed with Latin/numeric
         content — a hard requirement here (Sections 23/26/40). Chromium's text engine handles
         Persian shaping and RTL correctly and gives print-accurate, CSS-paginated output. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NTNP.Pricing.Domain\NTNP.Pricing.Domain.csproj" />
    <ProjectReference Include="..\NTNP.Pricing.Contracts\NTNP.Pricing.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" />
  </ItemGroup>

</Project>
